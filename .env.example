# Copiá este archivo a `.env.local` y completá con los valores de tu proyecto:
# Supabase → Project Settings → API Keys / Data API.
#
# Ambos valores son PÚBLICOS (viajan al navegador). La protección de los datos
# la dan las políticas RLS de la base. NO pongas acá la "secret key".

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
